{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/_py.sh\" intent-router.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/_py.sh\" url-scraper.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/idea-observer.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/transcript.sh\"",
            "timeout": 45
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/_py.sh\" handoff-sync.py",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-start.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/_py.sh\" mt-session-init.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/idea-flush.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-stop.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/subagent-start.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/subagent-stop.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-stop.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/safety-gate.sh\"",
            "timeout": 30,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/safety-gate.sh\"",
            "timeout": 30,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(git add *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/safety-gate.sh\"",
            "timeout": 30,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(git commit)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/safety-gate.sh\"",
            "timeout": 30,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(git push)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/safety-gate.sh\"",
            "timeout": 30,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/commit-format.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(git commit)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/commit-format.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(git checkout *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/branch-naming.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(git switch *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/branch-naming.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(git branch *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/branch-naming.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(git worktree *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/branch-naming.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
